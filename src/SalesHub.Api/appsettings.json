{
  "ConnectionStrings": {
    "Default": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "DataProtection": {
    "KeyRingPath": ""
  },
  "FileStorage": {
    "RootPath": "data/uploads"
  },
  "Security": {
    "FreshAuthWindow": "00:15:00",
    "IdleCapabilityLease": "00:05:00",
    "IdleHeartbeatCadence": "00:01:00",
    "MinIdleThresholdSeconds": 60,
    "MonitoredRoles": [ "SalesAgent" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
